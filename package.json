{
  "name": "rotaguide-spotlight",
  "version": "1.1.3",
  "description": "RotaGuide Spotlight: markdown, JSON, and YAML-driven spotlight walkthroughs for React apps",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EBPkobli/rotaguide-spotlight.git"
  },
  "homepage": "https://github.com/EBPkobli/rotaguide-spotlight#readme",
  "bugs": {
    "url": "https://github.com/EBPkobli/rotaguide-spotlight/issues"
  },
  "keywords": [
    "react",
    "spotlight",
    "tour",
    "walkthrough",
    "guide",
    "markdown",
    "yaml",
    "json",
    "product-tour"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "GUIDE_MD_STANDARD.md",
    "TOOL_FEATURES_GUIDE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "example:dev": "npm run dev --prefix examples/simple-react",
    "example:build": "npm run build --prefix examples/simple-react"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
